{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recursive_harness_summary_v2.schema.json",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "peak_ram_mb",
    "avg_ram_mb",
    "peak_io_mb_s",
    "cpu_pct",
    "steps_completed",
    "checkpoints",
    "cleanup_passed"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "status": {
      "enum": ["completed", "aborted", "failed", "cleanup_failed", "blocked"]
    },
    "abort_reason": {"type": ["string", "null"]},
    "peak_ram_mb": {"type": "number", "minimum": 0},
    "avg_ram_mb": {"type": "number", "minimum": 0},
    "peak_io_mb_s": {"type": "number", "minimum": 0},
    "cpu_pct": {"type": "number", "minimum": 0},
    "steps_completed": {"type": "integer", "minimum": 0},
    "checkpoints": {"type": "array", "items": {"type": "string"}},
    "cleanup_passed": {"type": "boolean"}
  },
  "additionalProperties": true
}
